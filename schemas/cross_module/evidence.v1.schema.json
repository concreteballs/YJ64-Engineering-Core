{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yj64.dev/cross-module/evidence.v1.schema.json",
  "title": "YJ64 Cross-Module Evidence v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "evidence_id",
    "evidence_type",
    "source"
  ],
  "properties": {
    "schema_id": {
      "const": "yj64.cross_module.evidence.v1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "type": "string"
    },
    "applicability": {
      "type": "string"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
