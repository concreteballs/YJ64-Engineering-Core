{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yj64.dev/cross-module/enhancement-proposal.v1.schema.json",
  "title": "YJ64 Cross-Module Enhancement Proposal v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "proposal_id",
    "candidate",
    "proposing_module",
    "objective",
    "improvement",
    "mechanism",
    "expected_benefit",
    "success_criteria",
    "evidence"
  ],
  "properties": {
    "schema_id": {
      "const": "yj64.cross_module.enhancement_proposal.v1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "$ref": "candidate.v1.schema.json"
    },
    "proposing_module": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "improvement": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "expected_benefit": {
      "type": "string",
      "minLength": 1
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "evidence.v1.schema.json"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deferred",
        "needs_evidence"
      ]
    },
    "decision_rationale": {
      "type": "string"
    },
    "decision_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "rejected",
              "deferred",
              "needs_evidence"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "decision_rationale": {
            "minLength": 1
          },
          "decision_version": {
            "minimum": 1
          }
        },
        "required": [
          "decision_rationale",
          "decision_version"
        ]
      }
    }
  ]
}
