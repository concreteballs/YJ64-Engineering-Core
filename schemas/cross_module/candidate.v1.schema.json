{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yj64.dev/cross-module/candidate.v1.schema.json",
  "title": "YJ64 Cross-Module Candidate v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "candidate_id",
    "version",
    "candidate_schema_version",
    "origin_module"
  ],
  "properties": {
    "schema_id": {
      "const": "yj64.cross_module.candidate.v1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_schema_version": { "type": "string", "minLength": 1 },
    "candidate_schema_version": { "type": "string", "minLength": 1 },
    "origin_module": {
      "type": "string",
      "minLength": 1
    },
    "intended_scope": {
      "type": "string"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
