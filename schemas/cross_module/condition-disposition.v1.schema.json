{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yj64.dev/cross-module/condition-disposition.v1.schema.json",
  "title": "YJ64 Parent Coordinator Condition Disposition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "candidate", "reviewer_module", "condition_id", "condition_text", "status", "rationale", "decided_by", "decision_version"],
  "properties": {
    "schema_id": { "const": "yj64.cross_module.condition_disposition.v1" },
    "schema_version": { "const": "1.0" },
    "candidate": { "$ref": "candidate.v1.schema.json" },
    "reviewer_module": { "type": "string", "minLength": 1 },
    "condition_id": { "type": "string", "minLength": 1 },
    "condition_text": { "type": "string", "minLength": 1 },
    "status": { "enum": ["unresolved", "satisfied", "rejected", "deferred"] },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "$ref": "evidence.v1.schema.json" } },
    "decided_by": { "const": "parent_coordinator" },
    "decision_version": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "satisfied" } }, "required": ["status"] },
      "then": { "properties": { "evidence": { "minItems": 1 } }, "required": ["evidence"] }
    }
  ]
}
